## Multistage build for the buxiny fork of filebrowser.
##
## Runtime layout follows hurlenko/filebrowser-docker (the image this fork
## replaces): everything lives under /data (browsed root) and /config
## (filebrowser.db), the service listens on 8080, and configuration is done
## through FB_* environment variables.
##
## Unlike hurlenko's image (which downloads upstream release binaries) this
## builds the fork's own source, so fork-specific changes such as TOTP
## two-factor authentication are included.

## First stage: build the frontend assets
FROM node:24-alpine AS frontend

WORKDIR /src/frontend

COPY frontend/package.json frontend/pnpm-lock.yaml ./
RUN corepack enable && pnpm install --frozen-lockfile

COPY frontend/ ./
RUN pnpm run build

## Second stage: build the backend with the embedded frontend
FROM golang:1.26-alpine AS builder

WORKDIR /src

# Fetch dependencies first for better layer caching
COPY go.mod go.sum ./
RUN go mod download

COPY . .
COPY --from=frontend /src/frontend/dist frontend/dist

ARG VERSION=dev
ARG COMMIT=unknown

RUN CGO_ENABLED=0 go build \
    -ldflags="-s -w -X 'github.com/filebrowser/filebrowser/v2/version.Version=${VERSION}' -X 'github.com/filebrowser/filebrowser/v2/version.CommitSHA=${COMMIT}'" \
    -o /filebrowser .

## Third stage: minimal runtime image
FROM alpine:3

ARG BUILD_DATE
ARG VCS_REF
ARG VERSION

LABEL org.label-schema.build-date=$BUILD_DATE \
    org.label-schema.name="filebrowser (buxiny fork)" \
    org.label-schema.description="Web File Browser with TOTP two-factor authentication, built from the buxiny/filebrowser fork" \
    org.label-schema.version=$VERSION \
    org.label-schema.url="https://github.com/buxiny/filebrowser" \
    org.label-schema.vcs-ref=$VCS_REF \
    org.label-schema.vcs-url="https://github.com/buxiny/filebrowser" \
    org.label-schema.vcs-type="Git" \
    org.label-schema.license="Apache-2.0" \
    org.label-schema.vendor="buxiny" \
    org.label-schema.schema-version="1.0"

COPY --from=builder /filebrowser /filebrowser

RUN apk add --no-cache ca-certificates tzdata \
    && mkdir -p -m 777 /config \
    && mkdir -p -m 777 /data

EXPOSE 15012

ENTRYPOINT ["/filebrowser"]
CMD ["--root=/data", "--address=0.0.0.0", "--port=15012", "--database=/config/filebrowser.db"]
